+
+    fn delayed_roll_response(
+        bandwidth: f64,
+        sensor_delay: usize,
+        command_delay: usize,
+    ) -> (f64, f64) {
+        use std::collections::VecDeque;
+        let inertia = 0.02945;
+        let (torque_gain, angle_gain) = critical_gains(inertia, bandwidth);
+        let mut angle: f64 = 0.05;
+        let mut rate = 0.0;
+        let mut filtered_rate = 0.0;
+        let mut motor_torque = 0.0;
+        let mut applied_torque = 0.0;
+        let mut last_sample = angle;
+        let mut history = vec![angle];
+        let mut pending = VecDeque::new();
+        let mut peak = angle.abs();
+        // Linearized pinned-inertia roll plant, 1 ms integration, 25 Hz
+        // zero-order-hold control, 25 ms motor lag and the actual 0.5 filter.
+        // Stop at 0.25 rad: departure from the linear regime is failure,
+        // not evidence about the simulated vehicle's subsequent trajectory.
+        for step in 0_usize..12_000 {
+            if step.is_multiple_of(40) {
+                let measured = history[step.saturating_sub(sensor_delay)];
+                let raw_rate = (measured - last_sample) / 0.04;
+                last_sample = measured;
+                filtered_rate = 0.5 * raw_rate + 0.5 * filtered_rate;
+                pending.push_back((
+                    step + command_delay,
+                    torque_gain * (-angle_gain * measured - filtered_rate),
+                ));
+            }
+            while pending.front().is_some_and(|(due, _)| *due <= step) {
+                applied_torque = pending.pop_front().unwrap().1;
+            }
+            motor_torque += (applied_torque - motor_torque) * (1.0 - (-0.001_f64 / 0.025).exp());
+            rate += motor_torque / inertia * 0.001;
+            angle += rate * 0.001;
+            history.push(angle);
+            peak = peak.max(angle.abs());
+            if peak > 0.25 {
+                break;
+            }
+        }
+        (peak, angle.abs())
+    }
+
