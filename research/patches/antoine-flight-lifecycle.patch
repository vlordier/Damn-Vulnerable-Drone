+fn actuator_lifecycle_ack_matches(state: &serde_json::Value, request: &serde_json::Value) -> bool {
+    let Some(issued_at_ms) = request.get("issuedAtMs").and_then(serde_json::Value::as_u64) else {
+        return false;
+    };
+    state.get("contract").and_then(serde_json::Value::as_str)
+        == Some("furia.gzsitl.actuator-lifecycle-state")
+        && state.get("version").and_then(serde_json::Value::as_str) == Some("1.0.0")
+        && state.get("source").and_then(serde_json::Value::as_str) == Some("gz-sitl-applier")
+        && state.get("request") == Some(request)
+        && state.get("armed").and_then(serde_json::Value::as_bool)
+            == request.get("armed").and_then(serde_json::Value::as_bool)
+        && state.get("sequence").and_then(serde_json::Value::as_u64)
+            == request.get("sequence").and_then(serde_json::Value::as_u64)
+        && state.get("runId") == request.get("runId")
+        && state.get("vehicleId") == request.get("identity")
+        && state.get("recordedAtUnixMs").and_then(serde_json::Value::as_u64).is_some_and(|time| {
+            time >= issued_at_ms.saturating_sub(50) && time <= issued_at_ms + 250
+        })
+        && state.get("frameId") == request.get("frameId")
+        && state.get("requestId") == request.get("requestId")
+        && state.get("stopCommandSequence") == request.get("stopCommandSequence")
+}
+
+async fn change_actuator_lifecycle(
+    client: &async_nats::Client,
+    authority: &Arc<tokio::sync::Mutex<Authority>>,
+    observations: &Arc<tokio::sync::Mutex<Observations>>,
+    directory: &str,
+    armed: bool,
+    first_sequence: u64,
+    requests: &mut Vec<serde_json::Value>,
+) -> Result<serde_json::Value, Box<dyn std::error::Error>> {
+    // A bounded handshake with the sole actuator writer, independent of the
+    // grant/stop lifecycle. The acknowledgement must echo this exact signed
+    // request, not merely an armed flag found in an old file.
+    for attempt in 0..10 {
+        let stop_sequence = if armed {
+            0
+        } else {
+            observations
+                .lock()
+                .await
+                .stop_commands
+                .last()
+                .and_then(|value| value.get("sequence"))
+                .and_then(serde_json::Value::as_u64)
+                .unwrap_or(0)
+        };
+        if !armed && stop_sequence == 0 {
+            tokio::time::sleep(Duration::from_millis(200)).await;
+            continue;
+        }
+        let authority = authority.lock().await;
+        let issued_at_ms = now_ms();
+        let sequence = first_sequence + attempt;
+        let mut request = serde_json::json!({
+            "schema": "furia.gzsitl.actuator-lifecycle", "version": "1.0.0",
+            "identity": authority.vehicle_id, "runId": authority.run_id,
+            "frameId": authority.world_frame_id, "sequence": sequence,
+            "requestId": format!("{}:lifecycle:{sequence}", authority.vehicle_id),
+            "armed": armed, "stopCommandSequence": stop_sequence,
+            "issuedAtMs": issued_at_ms, "expiresAtMs": issued_at_ms + 250,
+            "signatureAlgorithm": "Ed25519",
+        });
+        sign_in_place(&authority.key, &mut request)?;
+        let subject = format!("furia.gzsitl.commands.{}", authority.vehicle_id);
+        let state_path = std::path::Path::new(directory)
+            .join(format!("{}.armed-state.json", authority.vehicle_id));
+        drop(authority);
+        requests.push(request.clone());
+        client.publish(subject, serde_json::to_vec(&request)?.into()).await?;
+        client.flush().await?;
+        for _ in 0..4 {
+            tokio::time::sleep(Duration::from_millis(50)).await;
+            let safe_file = std::fs::symlink_metadata(&state_path).is_ok_and(|metadata| {
+                metadata.is_file() && !metadata.file_type().is_symlink() && metadata.len() <= 16_384
+            });
+            if !safe_file {
+                continue;
+            }
+            let Some(state) = std::fs::read(&state_path).ok().and_then(|data| parse_json(&data))
+            else {
+                continue;
+            };
+            if actuator_lifecycle_ack_matches(&state, &request) {
+                return Ok(state);
+            }
+        }
+    }
+    Err(format!("actuator lifecycle handshake timed out: armed={armed}").into())
+}
