+fn swarm_arrival_radius(name: &str, default: f64) -> Result<f64, Box<dyn std::error::Error>> {
+    let raw = match std::env::var(name) {
+        Ok(value) => Some(value),
+        Err(std::env::VarError::NotPresent) => None,
+        Err(error) => return Err(error.into()),
+    };
+    parse_swarm_arrival_radius(name, raw.as_deref(), default)
+}
+
+fn parse_swarm_arrival_radius(
+    name: &str,
+    raw: Option<&str>,
+    default: f64,
+) -> Result<f64, Box<dyn std::error::Error>> {
+    let value = raw.map(str::parse).transpose()?.unwrap_or(default);
+    if !value.is_finite() || !(0.05..=2.0).contains(&value) {
+        return Err(format!("{name} must be finite and between 0.05 and 2.0 metres").into());
+    }
+    Ok(value)
+}
