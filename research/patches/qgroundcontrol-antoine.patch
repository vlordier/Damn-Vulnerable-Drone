+    if (_isGenericQuadVehicle(vehicle)) {
+        Q_UNUSED(forwardFlightLoiterRadius);
+        const QGeoCoordinate home = vehicle->homePosition();
+        if (!home.isValid() || !gotoCoord.isValid()) {
+            QGC::showAppMessage(QStringLiteral("Antoine SITL needs a valid home position for local position commands."));
+            return false;
+        }
+        const double distance = home.distanceTo(gotoCoord);
+        const double bearing = qDegreesToRadians(home.azimuthTo(gotoCoord));
+        const double north = distance * qCos(bearing);
+        const double east = distance * qSin(bearing);
+        const double relativeAltitude = vehicle->coordinate().altitude() - home.altitude();
+        if (distance > 3.0 || relativeAltitude < 0.0 || relativeAltitude > 3.0) {
+            QGC::showAppMessage(QStringLiteral("Antoine SITL position targets are limited to 3 metres from home and 0–3 metres altitude."));
+            return false;
+        }
+        SharedLinkInterfacePtr link = vehicle->vehicleLinkManager()->primaryLink().lock();
+        if (!link) {
+            return false;
+        }
+        mavlink_message_t message{};
+        mavlink_msg_set_position_target_local_ned_pack_chan(
+            static_cast<uint8_t>(MAVLinkProtocol::instance()->getSystemId()),
+            static_cast<uint8_t>(MAVLinkProtocol::getComponentId()), link->mavlinkChannel(), &message,
+            static_cast<uint32_t>(qgcApp()->msecsSinceBoot()), static_cast<uint8_t>(vehicle->id()),
+            static_cast<uint8_t>(vehicle->defaultComponentId()), MAV_FRAME_LOCAL_NED, 0x0DF8,
+            static_cast<float>(north), static_cast<float>(east), static_cast<float>(-relativeAltitude),
+            0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f);
+        vehicle->setFlightMode(QStringLiteral("Guided"));
+        QTimer::singleShot(100, vehicle, [vehicle, link, message]() {
+            vehicle->sendMessageOnLinkThreadSafe(link.get(), message);
+        });
+        return true;
+    }
