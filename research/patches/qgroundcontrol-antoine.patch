+bool FirmwarePlugin::_isGenericQuadVehicle(const Vehicle *vehicle) const
+{
+    return vehicle && _autopilotType() == MAV_AUTOPILOT_GENERIC &&
+           vehicle->vehicleType() == MAV_TYPE_QUADROTOR && vehicle->id() == 1 &&
+           vehicle->defaultComponentId() == MAV_COMP_ID_AUTOPILOT1;
+}
+
+double FirmwarePlugin::minimumTakeoffAltitudeMeters(Vehicle *vehicle) const
+{
+    return _isGenericQuadVehicle(vehicle) ? 0.4 : 3.048;
+}
+
+bool FirmwarePlugin::isCapable(const Vehicle *vehicle, FirmwareCapabilities capabilities) const
+{
+    if (!_isGenericQuadVehicle(vehicle)) {
+        return false;
+    }
+    constexpr FirmwareCapabilities antoineCapabilities = static_cast<FirmwareCapabilities>(
+        SetFlightModeCapability | PauseVehicleCapability | GuidedModeCapability |
+        TakeoffVehicleCapability | GuidedTakeoffCapability);
+    return (capabilities & antoineCapabilities) == capabilities;
+}
+
+QStringList FirmwarePlugin::flightModes(Vehicle *vehicle) const
+{
+    if (!_isGenericQuadVehicle(vehicle)) {
+        return {};
+    }
+    return {QStringLiteral("Stabilize"), QStringLiteral("Guided"), QStringLiteral("Auto"),
+            QStringLiteral("Hold"), QStringLiteral("RTL"), QStringLiteral("Land")};
+}
+
