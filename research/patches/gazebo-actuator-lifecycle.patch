diff --git a/tools/gz-sitl-applier/actuator-lifecycle.hh b/tools/gz-sitl-applier/actuator-lifecycle.hh
new file mode 100644
--- /dev/null
+++ b/tools/gz-sitl-applier/actuator-lifecycle.hh
@@ -0,0 +1,91 @@
+#pragma once
+
+#include <string>
+#include "execution-auth.hh"
+#include "command-freshness.hh"
+#include "audit-records.hh"
+
+namespace {
+
+struct ActuatorLifecycle {
+  bool armed = false;
+  unsigned long long sequence = 0;
+};
+
+struct LifecycleRequest {
+  bool armed = false;
+  unsigned long long sequence = 0;
+  unsigned long long stop_sequence = 0;
+  std::string request_id;
+};
+
+// Lifecycle sequences are independent of the controller's actuator sequence.
+// No unsigned stop, grant expiry or neutral motor sample changes this latch.
+bool validate_lifecycle_request(json_object *command, const char *pinned_key,
+    const std::string &identity, const std::string &run_id, const std::string &frame_id,
+    const ActuatorLifecycle &state, bool explicitly_stopped,
+    unsigned long long last_stop_sequence, unsigned long long observed_at_ms,
+    LifecycleRequest &request) {
+  std::string schema, version, vehicle, run, frame, algorithm, signature_hex;
+  if (!get_string(command, "schema", schema) || schema != "furia.gzsitl.actuator-lifecycle" ||
+      !get_string(command, "version", version) || version != "1.0.0" ||
+      !get_string(command, "identity", vehicle) || vehicle != identity ||
+      !get_string(command, "runId", run) || run != run_id || run_id.empty() ||
+      !get_string(command, "frameId", frame) || frame != frame_id || frame_id.empty() ||
+      !get_boolean(command, "armed", request.armed) ||
+      !get_u64(command, "sequence", request.sequence) || request.sequence <= state.sequence ||
+      !get_u64(command, "stopCommandSequence", request.stop_sequence) ||
+      !get_string(command, "requestId", request.request_id) ||
+      request.request_id != identity + ":lifecycle:" + std::to_string(request.sequence) ||
+      !get_string(command, "signatureAlgorithm", algorithm) || algorithm != "Ed25519" ||
+      !get_string(command, "signature", signature_hex) || signature_hex.size() != 128 ||
+      !assess_command_freshness(command, observed_at_ms).fresh) return false;
+  if (request.armed ? request.stop_sequence != 0 :
+      (!explicitly_stopped || last_stop_sequence == 0 ||
+       request.stop_sequence != last_stop_sequence)) return false;
+  unsigned char public_key[crypto_sign_PUBLICKEYBYTES], signature[crypto_sign_BYTES];
+  if (!decode_core_public_key(pinned_key, public_key) ||
+      sodium_hex2bin(signature, sizeof(signature), signature_hex.c_str(), signature_hex.size(),
+                     nullptr, nullptr, nullptr) != 0) return false;
+  json_object *projection = json_object_new_object();
+  if (!projection) return false;
+  json_object_object_foreach(command, key, value) {
+    if (std::strcmp(key, "signature") != 0)
+      json_object_object_add(projection, key, json_object_get(value));
+  }
+  const std::string canonical = canonical_json(projection);
+  json_object_put(projection);
+  return crypto_sign_verify_detached(signature,
+      reinterpret_cast<const unsigned char *>(canonical.data()), canonical.size(), public_key) == 0;
+}
+
+bool record_lifecycle_state(const char *directory, const std::string &identity,
+    const std::string &model, const LifecycleRequest &request, json_object *signed_request) {
+  if (!directory || !*directory) return false;
+  json_object *row = json_object_new_object();
+  if (!row) return false;
+  json_object_object_add(row, "contract", json_object_new_string("furia.gzsitl.actuator-lifecycle-state"));
+  json_object_object_add(row, "version", json_object_new_string("1.0.0"));
+  json_object_object_add(row, "source", json_object_new_string("gz-sitl-applier"));
+  json_object_object_add(row, "vehicleId", json_object_new_string(identity.c_str()));
+  json_object_object_add(row, "modelId", json_object_new_string(model.c_str()));
+  json_object_object_add(row, "sequence", json_object_new_uint64(request.sequence));
+  json_object_object_add(row, "armed", json_object_new_boolean(request.armed));
+  json_object_object_add(row, "requestId", json_object_new_string(request.request_id.c_str()));
+  json_object_object_add(row, "stopCommandSequence", json_object_new_uint64(request.stop_sequence));
+  json_object_object_add(row, "request", signed_request ? json_object_get(signed_request) : json_object_new_object());
+  bool result = add_run_context_and_timestamp(row);
+  const char *serialized = json_object_to_json_string_ext(row, JSON_C_TO_STRING_PLAIN);
+  if (result && serialized) {
+    const std::string payload(serialized);
+    // A transition is acknowledged only after its audit and latest-state file
+    // are durable. Failures leave the latch unchanged and stop command intake.
+    result = append_audit_line_sync(std::string(directory) + "/actuator-lifecycle.jsonl", payload, 8192) &&
+        write_private_file_atomically(std::string(directory) + "/" + identity + ".armed-state.json",
+            payload + "\n", std::to_string(request.sequence));
+  } else result = false;
+  json_object_put(row);
+  return result;
+}
