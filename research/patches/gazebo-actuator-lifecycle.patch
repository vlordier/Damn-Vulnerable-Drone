+void test_explicit_actuator_lifecycle() {
+  unsigned char seed[crypto_sign_SEEDBYTES] = {7};
+  unsigned char public_key[crypto_sign_PUBLICKEYBYTES], secret_key[crypto_sign_SECRETKEYBYTES];
+  assert(crypto_sign_seed_keypair(public_key, secret_key, seed) == 0);
+  char public_hex[65];
+  sodium_bin2hex(public_hex, sizeof(public_hex), public_key, sizeof(public_key));
+  const auto make_request = [&](bool armed, unsigned long long sequence, unsigned long long stop) {
+    json_object *value = json_object_new_object();
+    put_string(value, "schema", "furia.gzsitl.actuator-lifecycle");
+    put_string(value, "version", "1.0.0");
+    put_string(value, "identity", "drone-1");
+    put_string(value, "runId", "lifecycle-test");
+    put_string(value, "frameId", "enu-test");
+    put_string(value, "requestId", "drone-1:lifecycle:" + std::to_string(sequence));
+    put_string(value, "signatureAlgorithm", "Ed25519");
+    put_u64(value, "issuedAtMs", 1000);
+    put_u64(value, "expiresAtMs", 1250);
+    put_u64(value, "sequence", sequence);
+    put_u64(value, "stopCommandSequence", stop);
+    json_object_object_add(value, "armed", json_object_new_boolean(armed));
+    resign_grant(value, secret_key);
+    return value;
+  };
+  ActuatorLifecycle state;
+  LifecycleRequest request;
+  json_object *arm = make_request(true, 1, 0);
+  const auto valid = [&](json_object *value, bool stopped, unsigned long long last_stop,
+                         unsigned long long now = 1100) {
+    return validate_lifecycle_request(value, public_hex, "drone-1", "lifecycle-test", "enu-test",
+        state, stopped, last_stop, now, request);
+  };
+  assert(valid(arm, false, 0));
+  state = {request.armed, request.sequence};
+  assert(state.armed);
+  assert(!valid(arm, false, 0)); // replay cannot refresh the latch
+  json_object *disarm = make_request(false, 2, 42);
+  assert(!valid(disarm, false, 42)); // no inference from a revoke or neutral motors
+  assert(!valid(disarm, true, 41)); // requires the exact latest explicit stop
+  assert(!valid(disarm, true, 42, 1250)); // expired
+  assert(valid(disarm, true, 42));
+  put_string(disarm, "runId", "other-run");
+  resign_grant(disarm, secret_key);
+  assert(!valid(disarm, true, 42));
+  put_string(disarm, "runId", "lifecycle-test");
+  put_string(disarm, "identity", "drone-2");
+  resign_grant(disarm, secret_key);
+  assert(!valid(disarm, true, 42));
+  put_string(disarm, "identity", "drone-1");
+  resign_grant(disarm, secret_key);
+  json_object_object_add(disarm, "armed", json_object_new_int(0));
+  assert(!valid(disarm, true, 42)); // strict boolean and signed payload
+  json_object_put(disarm);
+  disarm = make_request(false, 2, 42);
+  put_u64(disarm, "stopCommandSequence", 43);
+  assert(!valid(disarm, true, 43)); // mutation must invalidate its signature
+  json_object_put(disarm);
+  disarm = make_request(false, 2, 42);
+  assert(valid(disarm, true, 42));
+  char directory[] = "runs/actuator-lifecycle-test.XXXXXX";
+  assert(::mkdtemp(directory));
+  assert(::setenv("FURIA_SITL_RUN_ID", "lifecycle-test", 1) == 0);
+  assert(::setenv("GZ_SITL_WORLD_SHA256", std::string(64, 'a').c_str(), 1) == 0);
+  assert(::setenv("FURIA_PRIME_ENU_FRAME_ID", "enu-test", 1) == 0);
+  assert(record_lifecycle_state(directory, "drone-1", "isr", request, disarm));
+  std::ifstream input(std::string(directory) + "/drone-1.armed-state.json");
+  std::string row;
+  assert(std::getline(input, row));
+  json_object *saved = json_tokener_parse(row.c_str());
+  bool armed = true;
+  assert(saved && get_boolean(saved, "armed", armed) && !armed);
+  json_object_put(saved);
+  input.close();
+  ::unlink((std::string(directory) + "/drone-1.armed-state.json").c_str());
+  ::unlink((std::string(directory) + "/actuator-lifecycle.jsonl").c_str());
+  ::rmdir(directory);
+  json_object_put(arm);
+  json_object_put(disarm);
+}
